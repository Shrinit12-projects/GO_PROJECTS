{
  "dashboard": {
    "id": null,
    "title": "Auth Service - Complete Monitoring",
    "tags": ["auth", "microservice", "comprehensive"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(auth_service_http_requests_total[5m]))",
            "legendFormat": "Total RPS"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Time P95",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
      },
      {
        "id": 3,
        "title": "Error Rate %",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(auth_service_http_requests_total{status_code=~\"4..|5..\"}[5m])) / sum(rate(auth_service_http_requests_total[5m])) * 100",
            "legendFormat": "Error Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
      },
      {
        "id": 4,
        "title": "Login Success vs Failure",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_login_attempts_total{result=\"success\"}[5m])",
            "legendFormat": "Successful Logins"
          },
          {
            "expr": "rate(auth_service_login_attempts_total{result=\"failure\"}[5m])",
            "legendFormat": "Failed Logins"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "User Registrations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_user_registrations_total[5m])",
            "legendFormat": "Registrations/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "JWT Token Operations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"validate\"}[5m])",
            "legendFormat": "Token Validations"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"refresh\"}[5m])",
            "legendFormat": "Token Refreshes"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"blacklist\"}[5m])",
            "legendFormat": "Token Blacklists"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "Redis Cache Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"hit\"}[5m])",
            "legendFormat": "Cache Hits"
          },
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"miss\"}[5m])",
            "legendFormat": "Cache Misses"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
      },
      {
        "id": 8,
        "title": "Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "go_memstats_heap_alloc_bytes",
            "legendFormat": "Heap Allocated"
          },
          {
            "expr": "go_memstats_heap_inuse_bytes",
            "legendFormat": "Heap In Use"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  },
  "overwrite": true
}