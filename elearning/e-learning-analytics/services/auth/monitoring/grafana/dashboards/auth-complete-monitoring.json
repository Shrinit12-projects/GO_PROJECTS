{
  "dashboard": {
    "id": null,
    "title": "Auth Service - Complete Monitoring",
    "tags": ["auth", "microservice", "elearning"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate (req/sec)",
        "type": "stat",
        "targets": [{
          "expr": "sum(rate(auth_service_http_requests_total[5m]))",
          "legendFormat": "Total RPS"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "decimals": 2
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Time (P95/P50)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Error Rate %",
        "type": "stat",
        "targets": [{
          "expr": "sum(rate(auth_service_http_requests_total{status_code=~\"4..|5..\"}[5m])) / sum(rate(auth_service_http_requests_total[5m])) * 100",
          "legendFormat": "Error Rate"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "unit": "percent",
            "decimals": 2
          }
        },
        "gridPos": {"h": 8, "w": 3, "x": 15, "y": 0}
      },
      {
        "id": 4,
        "title": "Active Connections",
        "type": "stat",
        "targets": [{
          "expr": "auth_service_active_connections",
          "legendFormat": "Connections"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Login Success vs Failure Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_login_attempts_total{result=\"success\"}[5m])",
            "legendFormat": "Successful Logins"
          },
          {
            "expr": "rate(auth_service_login_attempts_total{result=\"failure\"}[5m])",
            "legendFormat": "Failed Logins"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "User Registration Rate",
        "type": "timeseries",
        "targets": [{
          "expr": "rate(auth_service_user_registrations_total[5m])",
          "legendFormat": "Registrations/sec"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "JWT Token Operations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"validate\"}[5m])",
            "legendFormat": "Token Validations"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"refresh\"}[5m])",
            "legendFormat": "Token Refreshes"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"blacklist\"}[5m])",
            "legendFormat": "Token Blacklists"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
      },
      {
        "id": 8,
        "title": "JWT Validation Performance",
        "type": "timeseries",
        "targets": [{
          "expr": "histogram_quantile(0.95, rate(auth_service_jwt_validation_duration_seconds_bucket[5m]))",
          "legendFormat": "JWT Validation P95"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
      },
      {
        "id": 9,
        "title": "Redis Cache Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"hit\"}[5m])",
            "legendFormat": "Cache Hits"
          },
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"miss\"}[5m])",
            "legendFormat": "Cache Misses"
          },
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"error\"}[5m])",
            "legendFormat": "Cache Errors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}
      },
      {
        "id": 10,
        "title": "MongoDB Operations",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_mongo_operations_total{result=\"success\"}[5m])",
            "legendFormat": "{{operation}} Success"
          },
          {
            "expr": "rate(auth_service_mongo_operations_total{result=\"error\"}[5m])",
            "legendFormat": "{{operation}} Errors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 11,
        "title": "Go Runtime - Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "go_memstats_heap_alloc_bytes",
            "legendFormat": "Heap Allocated"
          },
          {
            "expr": "go_memstats_heap_inuse_bytes",
            "legendFormat": "Heap In Use"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "bytes"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 12,
        "title": "Go Runtime - Goroutines & GC",
        "type": "timeseries",
        "targets": [
          {
            "expr": "go_goroutines",
            "legendFormat": "Goroutines"
          },
          {
            "expr": "rate(go_gc_duration_seconds_count[5m])",
            "legendFormat": "GC Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32}
      },
      {
        "id": 13,
        "title": "HTTP Status Code Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (status_code) (rate(auth_service_http_requests_total[5m]))",
            "legendFormat": "{{status_code}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32}
      },
      {
        "id": 14,
        "title": "Endpoint Performance Heatmap",
        "type": "timeseries",
        "targets": [{
          "expr": "sum by (endpoint) (rate(auth_service_http_requests_total[5m]))",
          "legendFormat": "{{endpoint}}"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s",
    "schemaVersion": 30,
    "version": 1
  }
}