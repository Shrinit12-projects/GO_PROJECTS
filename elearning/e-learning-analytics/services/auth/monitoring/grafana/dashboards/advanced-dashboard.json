{
  "dashboard": {
    "id": null,
    "title": "Auth Service - Advanced Monitoring Dashboard",
    "tags": ["auth", "advanced", "monitoring", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate by Endpoint",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(auth_service_http_requests_total[5m]))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Time Heatmap",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          },
          {
            "expr": "histogram_quantile(0.95, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.90, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P90"
          },
          {
            "expr": "histogram_quantile(0.50, rate(auth_service_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Authentication Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(auth_service_login_attempts_total{result=\"success\"}[5m]) / (rate(auth_service_login_attempts_total{result=\"success\"}[5m]) + rate(auth_service_login_attempts_total{result=\"failure\"}[5m])) * 100",
            "legendFormat": "Success Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Security Alerts - Failed Logins",
        "type": "timeseries",
        "targets": [
          {
            "expr": "increase(auth_service_login_attempts_total{result=\"failure\"}[1m])",
            "legendFormat": "Failed Logins/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8}
      },
      {
        "id": 5,
        "title": "Token Lifecycle Management",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"validate\"}[5m])",
            "legendFormat": "Validations/sec"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"refresh\"}[5m])",
            "legendFormat": "Refreshes/sec"
          },
          {
            "expr": "rate(auth_service_token_operations_total{operation=\"blacklist\"}[5m])",
            "legendFormat": "Blacklists/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Cache Hit Ratio",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(auth_service_redis_operations_total{result=\"hit\"}[5m]) / (rate(auth_service_redis_operations_total{result=\"hit\"}[5m]) + rate(auth_service_redis_operations_total{result=\"miss\"}[5m])) * 100",
            "legendFormat": "Hit Ratio %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 90}
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "Database Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(auth_service_mongo_operations_total{operation=\"find\", result=\"success\"}[5m])",
            "legendFormat": "MongoDB Reads/sec"
          },
          {
            "expr": "rate(auth_service_mongo_operations_total{operation=\"insert\", result=\"success\"}[5m])",
            "legendFormat": "MongoDB Writes/sec"
          },
          {
            "expr": "rate(auth_service_mongo_operations_total{result=\"error\"}[5m])",
            "legendFormat": "MongoDB Errors/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16}
      },
      {
        "id": 8,
        "title": "System Resource Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[5m]) * 100",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory MB"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 9,
        "title": "Go Runtime Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "go_goroutines",
            "legendFormat": "Goroutines"
          },
          {
            "expr": "go_threads",
            "legendFormat": "OS Threads"
          },
          {
            "expr": "rate(go_gc_duration_seconds_count[5m])",
            "legendFormat": "GC Rate/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}
      },
      {
        "id": 10,
        "title": "Memory Allocation Patterns",
        "type": "timeseries",
        "targets": [
          {
            "expr": "go_memstats_heap_alloc_bytes / 1024 / 1024",
            "legendFormat": "Heap Allocated MB"
          },
          {
            "expr": "go_memstats_heap_inuse_bytes / 1024 / 1024",
            "legendFormat": "Heap In Use MB"
          },
          {
            "expr": "go_memstats_stack_inuse_bytes / 1024 / 1024",
            "legendFormat": "Stack In Use MB"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}
      },
      {
        "id": 11,
        "title": "Network & File Descriptors",
        "type": "timeseries",
        "targets": [
          {
            "expr": "process_open_fds",
            "legendFormat": "Open File Descriptors"
          },
          {
            "expr": "process_max_fds",
            "legendFormat": "Max File Descriptors"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}
      },
      {
        "id": 12,
        "title": "Service Uptime & Health",
        "type": "stat",
        "targets": [
          {
            "expr": "time() - process_start_time_seconds",
            "legendFormat": "Uptime Seconds"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 32}
      },
      {
        "id": 13,
        "title": "Request Volume Trends",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(auth_service_http_requests_total[1m]))",
            "legendFormat": "1min avg"
          },
          {
            "expr": "sum(rate(auth_service_http_requests_total[5m]))",
            "legendFormat": "5min avg"
          },
          {
            "expr": "sum(rate(auth_service_http_requests_total[15m]))",
            "legendFormat": "15min avg"
          }
        ],
        "gridPos": {"h": 8, "w": 9, "x": 6, "y": 32}
      },
      {
        "id": 14,
        "title": "Error Distribution by Status Code",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (status_code) (rate(auth_service_http_requests_total{status_code=~\"4..\"}[5m]))",
            "legendFormat": "4xx - {{status_code}}"
          },
          {
            "expr": "sum by (status_code) (rate(auth_service_http_requests_total{status_code=~\"5..\"}[5m]))",
            "legendFormat": "5xx - {{status_code}}"
          }
        ],
        "gridPos": {"h": 8, "w": 9, "x": 15, "y": 32}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  },
  "overwrite": true
}